# Keep the Docker build context small and the image clean. The build context
# is the repo root (see backend/Dockerfile), so exclude local-only artifacts.
.git/
.venv/
venv/
**/__pycache__/
*.pyc
.DS_Store

# Rebuilt inside the image by `python -m backend.app.ingest`.
backend/data/chroma/

# Node / frontend build artifacts — not part of the backend image.
**/node_modules/
frontend/dist/

# Local env secrets — never bake into the image.
backend/.env
